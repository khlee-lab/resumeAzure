{
  "routes": [
    {
      "route": "/",
      "redirect": "/ja"
    },
    {
      "route": "/en/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/ja/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/*.{js,css,png,jpg,svg,ico,json}",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    }
  ],
  "navigationFallback": {
    "rewrite": "/404.html"
  },
  "responseOverrides": {
    "404": {
      "redirect": "/ja",
      "statusCode": 302
    }
  }
}